<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tiktok.log.mapper.RequestLogMapper">

    <resultMap id="RequestLogResultMap" type="com.tiktok.log.entity.RequestLog">
        <id property="id" column="id"/>
        <result property="requestId" column="request_id"/>
        <result property="userId" column="user_id"/>
        <result property="interfaceName" column="interface_name"/>
        <result property="method" column="method"/>
        <result property="path" column="path"/>
        <result property="inputData" column="input_data"/>
        <result property="outputData" column="output_data"/>
        <result property="costTime" column="cost_time"/>
        <result property="isSlow" column="is_slow"/>
        <result property="httpStatus" column="http_status"/>
        <result property="success" column="success"/>
        <result property="errorCode" column="error_code"/>
        <result property="clientIp" column="client_ip"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <resultMap id="ApiMetricsSummaryResultMap" type="com.tiktok.log.dto.ApiMetricsSummaryResponse">
        <result property="requestCount" column="request_count"/>
        <result property="successCount" column="success_count"/>
        <result property="failCount" column="fail_count"/>
        <result property="slowCount" column="slow_count"/>
        <result property="avgCostTime" column="avg_cost_time"/>
    </resultMap>

    <resultMap id="ApiMetricsRecordResultMap" type="com.tiktok.log.dto.ApiMetricsRecordResponse">
        <result property="path" column="path"/>
        <result property="method" column="method"/>
        <result property="requestCount" column="request_count"/>
        <result property="successCount" column="success_count"/>
        <result property="failCount" column="fail_count"/>
        <result property="slowCount" column="slow_count"/>
        <result property="avgCostTime" column="avg_cost_time"/>
        <result property="maxCostTime" column="max_cost_time"/>
        <result property="minCostTime" column="min_cost_time"/>
    </resultMap>

    <sql id="QueryWhere">
        <where>
            <if test="userId != null and userId != ''">
                AND user_id = #{userId}
            </if>
            <if test="requestId != null and requestId != ''">
                AND request_id = #{requestId}
            </if>
            <if test="path != null and path != ''">
                AND path LIKE CONCAT('%', #{path}, '%')
            </if>
            <if test="method != null and method != ''">
                AND method = #{method}
            </if>
            <if test="successValue != null">
                AND success = #{successValue}
            </if>
            <if test="isSlowValue != null">
                AND is_slow = #{isSlowValue}
            </if>
            <if test="errorCode != null and errorCode != ''">
                AND error_code = #{errorCode}
            </if>
            <if test="startDateTime != null">
                AND created_at &gt;= #{startDateTime}
            </if>
            <if test="endDateTime != null">
                AND created_at &lt;= #{endDateTime}
            </if>
        </where>
    </sql>

    <insert id="insert" parameterType="com.tiktok.log.entity.RequestLog">
        INSERT INTO request_log (
            id, request_id, user_id, interface_name, method, path,
            input_data, output_data, cost_time, is_slow, http_status, success,
            error_code, client_ip, created_at
        ) VALUES (
            #{id}, #{requestId}, #{userId}, #{interfaceName}, #{method}, #{path},
            #{inputData}, #{outputData}, #{costTime}, #{isSlow}, #{httpStatus}, #{success},
            #{errorCode}, #{clientIp}, #{createdAt}
        )
    </insert>

    <select id="countByQuery" parameterType="com.tiktok.log.dto.RequestLogPageQuery" resultType="long">
        SELECT COUNT(1)
        FROM request_log
        <include refid="QueryWhere"/>
    </select>

    <select id="selectPageByQuery" parameterType="com.tiktok.log.dto.RequestLogPageQuery" resultMap="RequestLogResultMap">
        SELECT id, request_id, user_id, interface_name, method, path,
               input_data, output_data, cost_time, is_slow, http_status,
               success, error_code, client_ip, created_at
        FROM request_log
        <include refid="QueryWhere"/>
        ORDER BY created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectApiMetricsSummary" parameterType="com.tiktok.log.dto.ApiMetricsQueryRequest" resultMap="ApiMetricsSummaryResultMap">
        SELECT COUNT(*) AS request_count,
               SUM(CASE WHEN success = 1 THEN 1 ELSE 0 END) AS success_count,
               SUM(CASE WHEN success = 0 THEN 1 ELSE 0 END) AS fail_count,
               SUM(CASE WHEN is_slow = 1 THEN 1 ELSE 0 END) AS slow_count,
               COALESCE(AVG(cost_time), 0) AS avg_cost_time
        FROM request_log
        <where>
            <if test="startDateTime != null">
                AND created_at &gt;= #{startDateTime}
            </if>
            <if test="endDateTime != null">
                AND created_at &lt;= #{endDateTime}
            </if>
            <if test="path != null and path != ''">
                AND path LIKE CONCAT('%', #{path}, '%')
            </if>
            <if test="method != null and method != ''">
                AND method = #{method}
            </if>
            <if test="includeAdmin != null and includeAdmin == false">
                AND path NOT LIKE '/api/v1/admin/%'
            </if>
        </where>
    </select>

    <select id="selectApiMetrics" parameterType="com.tiktok.log.dto.ApiMetricsQueryRequest" resultMap="ApiMetricsRecordResultMap">
        SELECT COALESCE(
                   MIN(CASE WHEN path LIKE '%{%' THEN path END),
                   MIN(path)
               ) AS path,
               method,
               COUNT(*) AS request_count,
               SUM(CASE WHEN success = 1 THEN 1 ELSE 0 END) AS success_count,
               SUM(CASE WHEN success = 0 THEN 1 ELSE 0 END) AS fail_count,
               SUM(CASE WHEN is_slow = 1 THEN 1 ELSE 0 END) AS slow_count,
               AVG(cost_time) AS avg_cost_time,
               MAX(cost_time) AS max_cost_time,
               MIN(cost_time) AS min_cost_time
        FROM request_log
        <where>
            <if test="startDateTime != null">
                AND created_at &gt;= #{startDateTime}
            </if>
            <if test="endDateTime != null">
                AND created_at &lt;= #{endDateTime}
            </if>
            <if test="path != null and path != ''">
                AND path LIKE CONCAT('%', #{path}, '%')
            </if>
            <if test="method != null and method != ''">
                AND method = #{method}
            </if>
            <if test="includeAdmin != null and includeAdmin == false">
                AND path NOT LIKE '/api/v1/admin/%'
            </if>
        </where>
        GROUP BY method, COALESCE(interface_name, path)
        HAVING COUNT(*) &gt;= #{minCount}
        ORDER BY
        <choose>
            <when test="orderByColumn == 'max_cost_time'">max_cost_time</when>
            <when test="orderByColumn == 'request_count'">request_count</when>
            <when test="orderByColumn == 'slow_count'">slow_count</when>
            <when test="orderByColumn == 'fail_count'">fail_count</when>
            <otherwise>avg_cost_time</otherwise>
        </choose>
        DESC
        LIMIT #{limit}
    </select>
</mapper>
