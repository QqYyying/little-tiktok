<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tiktok.user.mapper.TokenBlacklistMapper">

    <resultMap id="TokenBlacklistResultMap" type="com.tiktok.user.entity.TokenBlacklist">
        <id property="id" column="id"/>
        <result property="token" column="token"/>
        <result property="userId" column="user_id"/>
        <result property="expireAt" column="expire_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="selectByToken" resultMap="TokenBlacklistResultMap">
        SELECT id, token, user_id, expire_at, created_at
        FROM token_blacklist
        WHERE token = #{token}
        LIMIT 1
    </select>

    <select id="existsByToken" resultType="int">
        SELECT COUNT(1)
        FROM token_blacklist
        WHERE token = #{token}
    </select>

    <insert id="insert" parameterType="com.tiktok.user.entity.TokenBlacklist">
        INSERT IGNORE INTO token_blacklist (id, token, user_id, expire_at, created_at)
        VALUES (#{id}, #{token}, #{userId}, #{expireAt}, #{createdAt})
    </insert>
</mapper>
